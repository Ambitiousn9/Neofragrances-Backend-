DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=neofragrances
DB_SSL=false
PORT=5000
# Set to "production" when deployed. Disables DEV_EMAIL_LOG and drops the local
# development origins from the CORS allowlist. Required on Render: the server refuses
# to start there (RENDER is set) unless NODE_ENV=production (config-check.js).
NODE_ENV=
FRONTEND_URL=http://127.0.0.1:5500
GOOGLE_CLIENT_ID=
# Required: the server refuses to start without it. Signs login tokens, and is the
# local-development fallback for PAYMENT_SIGNING_SECRET below. In production it must be
# at least 32 characters. Use a long random value; never reuse the Paystack key.
JWT_SECRET=
PAYSTACK_SECRET_KEY=sk_test_your_key_here
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Comma-separated list of browser origins allowed to call this API. FRONTEND_URL is
# always allowed as well; in production put the Netlify origin in either one. Outside
# production, http://127.0.0.1:5500 and http://localhost:5500 are allowed automatically.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Signs the payment snapshot sent through Paystack. Required in production (at least
# 32 characters and different from JWT_SECRET; the server refuses to start otherwise).
# Optional locally: if empty, JWT_SECRET is used and a warning is printed at startup.
PAYMENT_SIGNING_SECRET=
# Optional: override only for local testing against a mock; leave empty in production.
PAYSTACK_API_BASE=
# Local development ONLY: set to true to print verification/password-reset links
# to the backend console instead of emailing them (used when SendGrid isn't set).
# Ignored when NODE_ENV=production or on Render. Never set this in production.
DEV_EMAIL_LOG=false
