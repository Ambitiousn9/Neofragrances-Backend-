DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=neofragrances
DB_SSL=false
PORT=5000
# Set to "production" when deployed. Disables DEV_EMAIL_LOG and drops the local
# development origins from the CORS allowlist.
NODE_ENV=
FRONTEND_URL=http://127.0.0.1:5500
GOOGLE_CLIENT_ID=
# Required. Signs login tokens, and is the fallback for PAYMENT_SIGNING_SECRET below.
# Use a long random value; never reuse the Paystack key.
JWT_SECRET=
PAYSTACK_SECRET_KEY=sk_test_your_key_here
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Comma-separated list of browser origins allowed to call this API. FRONTEND_URL is
# always allowed as well; in production put the Netlify origin in either one. Outside
# production, http://127.0.0.1:5500 and http://localhost:5500 are allowed automatically.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
# Optional: secret used to sign the payment snapshot sent through Paystack.
# Falls back to JWT_SECRET if empty. Use a long random value in production.
PAYMENT_SIGNING_SECRET=
# Optional: override only for local testing against a mock; leave empty in production.
PAYSTACK_API_BASE=
# Local development ONLY: set to true to print verification/password-reset links
# to the backend console instead of emailing them (used when SendGrid isn't set).
# Ignored when NODE_ENV=production or on Render. Never set this in production.
DEV_EMAIL_LOG=false
